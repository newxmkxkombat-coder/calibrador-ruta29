<?xml version="1.0" encoding="utf-8"?>
<!-- Notificación DESPLEGADA: todo en grande con los tres botones -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvGrande"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="30sp"
        android:textStyle="bold"
        android:text="—" />
    <TextView
        android:id="@+id/tvLinea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="16sp" />
    <TextView
        android:id="@+id/tvMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification"
        android:textSize="14sp"
        android:maxLines="3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/btMarcar"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.3"
            android:background="@drawable/boton_notif"
            android:gravity="center"
            android:text="✓ Ya marqué"
            android:textColor="#2F7FC4"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btDevolver"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/boton_notif"
            android:gravity="center"
            android:text="↩ Devolver"
            android:textColor="#2F7FC4"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/btDetener"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/boton_notif"
            android:gravity="center"
            android:text="Detener"
            android:textColor="#2F7FC4"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
